<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ shell_env_gui_label }}</string>

    <key>ProgramArguments</key>
    <array>
{% for arg in shell_env_gui_setenv_args %}
        <string>{{ arg | e }}</string>
{% endfor %}
    </array>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
